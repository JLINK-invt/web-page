{
  "name": "cosmos-compass-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "stylelint": "stylelint \"**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm stylelint && pnpm typecheck && pnpm build",
    "check:all": "pnpm lint && pnpm format:check && pnpm stylelint && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@types/stripe": "^8.0.417",
    "next": "16.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "postcss": "^8.5.32",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
