# URL pública del sitio (con protocolo, sin barra final)
NEXT_PUBLIC_SITE_URL=https://cosmoscompass.com

# Email que se muestra en la web y recibe las consultas
NEXT_PUBLIC_CONTACT_EMAIL=hola@cosmoscompass.com

# ID del formulario de Formspree (https://formspree.io)
# Si queda vacío, el formulario cae a un enlace mailto.
NEXT_PUBLIC_FORMSPREE_FORM_ID=

# URL base usada por las redirecciones de pago (origen de los callbacks)
NEXT_PUBLIC_BASE_URL=https://cosmoscompass.com

# Datos bancarios mostrados en /pago/transferencia
NEXT_PUBLIC_BANK_NAME=BBVA México
NEXT_PUBLIC_BANK_ACCOUNT_NAME=Cosmos Compass
NEXT_PUBLIC_BANK_CLABE=012180012345678901

# Stripe (tarjeta) — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal — https://developer.paypal.com/dashboard/applications
# PAYPAL_ENV: sandbox | live
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Mercado Pago — https://www.mercadopago.com.mx/developers/panel/app
# MERCADOPAGO_SANDBOX: true | false
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_ACCESS_TOKEN=

# Resend (correo de confirmación de pagos) — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=noreply@cosmoscompass.com
